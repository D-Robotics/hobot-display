#!/bin/bash
set -e

systemctl enable hobot-display.service

# Ensure helper is executable (some packagers strip +x from data files).
[ -f /usr/bin/hobot-xfwm4-replace.sh ] && chmod 755 /usr/bin/hobot-xfwm4-replace.sh 2>/dev/null || true

# Install per-user autostart for sunrise (more reliable than system-wide in this image).
USER_NAME="${HOBOT_XFCE_USER:-sunrise}"
USER_HOME="$(getent passwd "$USER_NAME" 2>/dev/null | cut -d: -f6 || true)"
if [ -n "$USER_HOME" ] && [ -d "$USER_HOME" ]; then
	mkdir -p "$USER_HOME/.config/autostart" 2>/dev/null || true
	cat >"$USER_HOME/.config/autostart/hobot-xfwm4-replace.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Hobot: xfwm4 replace
Comment=Restart xfwm4 after login to avoid desktop right-click flicker
Exec=/usr/bin/hobot-xfwm4-replace.sh
TryExec=/usr/bin/hobot-xfwm4-replace.sh
StartupNotify=false
Hidden=false
X-GNOME-Autostart-enabled=true
X-XFCE-Autostart-enabled=true
EOF
	chown -R "$USER_NAME":"$USER_NAME" "$USER_HOME/.config/autostart" 2>/dev/null || true
fi

exit 0
